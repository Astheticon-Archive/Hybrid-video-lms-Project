{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@revideo/2d/lib",
    "outDir": "./build",
    "paths": {
      "@revideo/2d/lib/jsx-runtime": ["./node_modules/@revideo/2d/lib/jsx-runtime.d.ts"]
    }
  },
  "include": [
    "src/**/*"
  ]
}
